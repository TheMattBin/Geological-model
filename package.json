{
  "name": "geological-model-hk",
  "version": "2.0.0",
  "description": "A web application that visualizes 3D geological voxel data using Three.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "convert-sample": "python scripts/convert_netcdf.py --sample --output-dir ./public/data",
    "typecheck": "tsc --noEmit",
    "test:browser": "playwright test",
    "test:data": "python -m unittest discover -s tests -p 'test_*.py'",
    "check:bundle": "node scripts/check-bundle.mjs",
    "test:production": "playwright test --config playwright.production.config.mjs",
    "test:visual": "playwright test --config playwright.visual.config.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheMattBin/Geological-model.git"
  },
  "keywords": [
    "three.js",
    "webgl",
    "volume-rendering",
    "geological",
    "voxel",
    "react",
    "vite"
  ],
  "author": "Matt Bin",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/TheMattBin/Geological-model/issues"
  },
  "homepage": "https://github.com/TheMattBin/Geological-model#readme",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.3.0",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "prop-types": "^15.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
